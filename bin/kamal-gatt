#!/usr/bin/env python3

import argparse
import asyncio
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from bleak import BleakClient, BleakScanner

from kamal.gatt_report import new_report, serialize_services
from kamal.identifiers import load_registry


REGISTRY_FILES = {
    "service": "service_uuids.json",
    "characteristic": "characteristic_uuids.json",
    "descriptor": "descriptor_uuids.json",
}


def load_gatt_registries():
    """Load the three required offline Bluetooth SIG registries."""
    registries = {
        namespace: load_registry(filename)
        for namespace, filename in REGISTRY_FILES.items()
    }

    revisions = {
        registry["source_commit"]
        for registry in registries.values()
    }
    if len(revisions) != 1:
        raise ValueError("GATT registries use different source revisions")

    provenance = {
        "source": "Bluetooth SIG Assigned Numbers",
        "source_commit": revisions.pop(),
        "registries": {
            namespace: {
                "file": REGISTRY_FILES[namespace],
                "source_file": registry["source_file"],
                "generated_at_utc": registry["generated_at_utc"],
            }
            for namespace, registry in registries.items()
        },
    }

    return registries, provenance


async def find_target(target, adapter, timeout):
    devices = await BleakScanner.discover(
        timeout=timeout,
        return_adv=True,
        bluez={"adapter": adapter},
    )

    target_normalized = target.upper()

    for address, (device, adv) in devices.items():
        if address.upper() == target_normalized:
            return device, adv

    return None, None


async def inspect_target(
    target, adapter, timeout, registries=None, provenance=None
):
    """Discover a target, then inspect it using the shared lifecycle."""
    report = new_report(target, adapter)

    if provenance is not None:
        report["identifier_resolution"] = provenance

    try:
        device, adv = await find_target(target, adapter, timeout)
    except Exception as exc:
        report["discovery"] = {
            "attempted": True,
            "found": False,
            "error": f"{type(exc).__name__}: {exc}",
        }
        return report, 2

    if device is None:
        report["discovery"] = {
            "attempted": True,
            "found": False,
            "error": None,
        }
        return report, 3

    return await inspect_discovered_device(
        device=device,
        adv=adv,
        adapter=adapter,
        timeout=timeout,
        registries=registries,
        provenance=provenance,
    )


async def inspect_discovered_device(
    device,
    adv,
    adapter,
    timeout,
    registries=None,
    provenance=None,
    authorization_provenance=None,
):
    """Inspect an already-discovered device without scanning again."""
    report = new_report(
        device.address,
        adapter,
        authorization=authorization_provenance,
    )

    if provenance is not None:
        report["identifier_resolution"] = provenance

    report["discovery"] = {
        "attempted": True,
        "found": True,
        "error": None,
        "name": device.name,
        "address": device.address,
        "rssi": adv.rssi,
        "advertised_service_uuids": list(adv.service_uuids),
    }

    report["connection"]["attempted"] = True
    report["connection"]["client_created"] = False

    try:
        client = BleakClient(
            device,
            timeout=timeout,
            pair=False,
        )
    except Exception as exc:
        report["connection"]["error"] = f"{type(exc).__name__}: {exc}"
        return report, 4

    report["connection"]["client_created"] = True
    status = 0

    try:
        try:
            await asyncio.wait_for(
                client.connect(),
                timeout=timeout,
            )
            report["connection"]["connected"] = client.is_connected

            if not client.is_connected:
                report["connection"]["error"] = (
                    "BleakClient.connect() returned without connected state"
                )
                status = 4

        except Exception as exc:
            report["connection"]["error"] = f"{type(exc).__name__}: {exc}"
            status = 4

        if status == 0:
            report["gatt"]["enumeration_attempted"] = True

            try:
                report["gatt"]["services"] = serialize_services(client.services, registries)
                report["gatt"]["enumerated"] = True
            except Exception as exc:
                report["gatt"]["error"] = f"{type(exc).__name__}: {exc}"
                status = 5

    finally:
        # Cleanup even if connect() failed or returned without connecting.
        report["disconnect"]["attempted"] = True

        try:
            await asyncio.wait_for(
                client.disconnect(),
                timeout=timeout,
            )
            report["disconnect"]["completed"] = not client.is_connected

            if not report["disconnect"]["completed"]:
                report["disconnect"]["error"] = (
                    "BleakClient.disconnect() returned while still connected"
                )

        except Exception as exc:
            report["disconnect"]["error"] = f"{type(exc).__name__}: {exc}"

    if report["disconnect"]["error"] is not None and status == 0:
        status = 6

    return report, status


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Read-only active BLE GATT enumeration for K'amal."
    )
    commands = parser.add_subparsers(dest="command", required=True)

    inspect = commands.add_parser("inspect")
    inspect.add_argument("target", help="BLE target address")
    inspect.add_argument("--adapter", default="hci0")
    inspect.add_argument("--timeout", type=float, default=10.0)
    inspect.add_argument("--json", dest="json_path")

    survey = commands.add_parser("survey")
    targeting = survey.add_mutually_exclusive_group(required=True)
    targeting.add_argument("--allowlist", type=Path)
    targeting.add_argument("--all-discovered", action="store_true")
    survey.add_argument("--acknowledge-scope", action="store_true")
    survey.add_argument("--adapter", default="hci0")
    survey.add_argument(
        "--discover-seconds",
        type=float,
        default=30.0,
        help="Discovery duration in seconds (default: 30, max: 60)",
    )
    survey.add_argument(
        "--max-devices",
        type=int,
        default=50,
        help="Maximum permitted devices to queue (default: 50, max: 100)",
    )
    survey.add_argument(
        "--execute",
        action="store_true",
        help="Perform active GATT metadata enumeration after discovery",
    )
    survey.add_argument(
        "--authorization",
        type=Path,
        help="v0.12 authorization_scope required for active survey execution",
    )
    survey.add_argument(
        "--safety-state-dir",
        type=Path,
        help="persistent v0.12 GATT safety-state directory for active execution",
    )
    survey.add_argument(
        "--timeout",
        type=float,
        default=10.0,
        help="Per-device connection and disconnect timeout in seconds",
    )
    survey.add_argument("--output-dir", type=Path, required=True)

    return parser.parse_args(argv)


async def async_main(argv=None):
    args = parse_args(argv)


    if args.command == "survey":
        import hashlib

        from kamal.active_contracts import (
            ContractValidationError,
            GATT_METADATA_OPERATION,
            load_json_source,
            validate_gatt_survey_authorization,
        )
        from kamal.evidence_contracts import atomic_create_json
        from kamal.gatt_safety import (
            SafetyInterlockError,
            acquire_active_run,
            latch_unsafe_stop,
            mark_rf_started,
            release_active_run,
        )
        from kamal.gatt_survey import (
            SurveyTargetPolicy,
            SurveyAbortedError,
            atomic_json_write,
            build_execution_manifest,
            cleanup_is_safe,
            discover_target_queue,
            run_survey_records,
            start_live_target_record_discovery,
            validate_discovery_settings,
            validate_survey_timeout,
        )

        try:
            validate_discovery_settings(
                args.discover_seconds,
                args.max_devices,
            )
            validate_survey_timeout(args.timeout)

            if args.all_discovered:
                policy = SurveyTargetPolicy(
                    mode="all_discovered",
                    acknowledge_scope=args.acknowledge_scope,
                )
            else:
                if args.acknowledge_scope:
                    raise ValueError(
                        "Scope acknowledgment is only valid "
                        "for all-discovered mode"
                    )

                targets = json.loads(
                    args.allowlist.read_text(encoding="utf-8")
                )
                if not isinstance(targets, list):
                    raise ValueError("Allowlist must be a JSON array")

                policy = SurveyTargetPolicy(
                    mode="allowlist",
                    allowlist=frozenset(targets),
                )

            if args.execute:
                if args.authorization is None:
                    raise ValueError(
                        "Active survey requires --authorization"
                    )
                if args.safety_state_dir is None:
                    raise ValueError(
                        "Active survey requires --safety-state-dir"
                    )
            elif args.authorization is not None or args.safety_state_dir is not None:
                raise ValueError(
                    "--authorization and --safety-state-dir are only valid with --execute"
                )

        except (OSError, ValueError, TypeError) as exc:
            print(f"Survey policy error: {exc}", file=sys.stderr)
            return 8

        authorization = None
        authorization_sha256 = None
        normalized_authorization = None
        authorization_provenance = None
        registries = None
        provenance = None

        if args.execute:
            try:
                authorization, authorization_sha256, _ = load_json_source(
                    args.authorization
                )
                preselected_targets = (
                    sorted(policy.allowlist)
                    if policy.allowlist is not None
                    else None
                )
                normalized_authorization = validate_gatt_survey_authorization(
                    authorization,
                    target_addresses=preselected_targets,
                    timeout_seconds=args.timeout,
                    max_targets=args.max_devices,
                    policy_mode=policy.mode,
                    scope_acknowledged=policy.acknowledge_scope,
                )
                authorization_provenance = {
                    "authorization_id": normalized_authorization["authorization_id"],
                    "sha256": authorization_sha256,
                    "operation_class": GATT_METADATA_OPERATION,
                }
                if "survey_scope" in normalized_authorization:
                    authorization_provenance["survey_scope"] = dict(
                        normalized_authorization["survey_scope"]
                    )
            except (
                OSError,
                ContractValidationError,
                TypeError,
                KeyError,
            ) as exc:
                print(f"Survey authorization error: {exc}", file=sys.stderr)
                return 9

            try:
                registries, provenance = load_gatt_registries()
            except (OSError, ValueError, KeyError, TypeError) as exc:
                print(
                    f"GATT registry error: {exc}. "
                    "See data/bluetooth/README.md.",
                    file=sys.stderr,
                )
                return 7

        try:
            if args.execute:
                if args.output_dir.exists():
                    raise ValueError(
                        "Active survey requires a new output directory"
                    )
                args.output_dir.mkdir(parents=True, exist_ok=False)
            else:
                args.output_dir.mkdir(parents=True, exist_ok=True)
        except (OSError, ValueError, TypeError) as exc:
            print(f"Survey policy error: {exc}", file=sys.stderr)
            return 8

        manifest_path = args.output_dir / "survey-manifest.json"
        lease_acquired = False
        survey_run_id = None
        survey_request_sha256 = None
        survey_scanner = None
        scanner_lifecycle = None

        if args.execute:
            survey_request = {
                "schema_version": "0.12.0",
                "record_type": "gatt_survey_execution_request",
                "authorization_id": normalized_authorization["authorization_id"],
                "authorization_sha256": authorization_sha256,
                "adapter": args.adapter,
                "policy": {
                    "mode": policy.mode,
                    "scope_acknowledged": policy.acknowledge_scope,
                    "allowlist": (
                        sorted(policy.allowlist)
                        if policy.allowlist is not None
                        else None
                    ),
                },
                "limits": {
                    "discover_seconds": args.discover_seconds,
                    "max_devices": args.max_devices,
                    "timeout": args.timeout,
                },
                "output_dir": str(args.output_dir.resolve()),
            }
            survey_request_path = args.output_dir / "survey-execution-request.json"

            try:
                atomic_create_json(survey_request_path, survey_request)
                survey_request_sha256 = hashlib.sha256(
                    survey_request_path.read_bytes()
                ).hexdigest()
                survey_run_id = (
                    f"survey:{normalized_authorization['authorization_id']}:"
                    f"{survey_request_sha256[:16]}"
                )
                acquire_active_run(
                    args.safety_state_dir,
                    plan_id=survey_run_id,
                    plan_sha256=survey_request_sha256,
                    authorization_sha256=authorization_sha256,
                    output_dir=args.output_dir,
                    targets=normalized_authorization["targets"],
                )
                lease_acquired = True
            except (OSError, SafetyInterlockError) as exc:
                print(f"Survey safety error: {exc}", file=sys.stderr)
                return 14

        if args.execute:
            try:
                mark_rf_started(args.safety_state_dir)
            except SafetyInterlockError as exc:
                print(f"Survey safety error: {exc}", file=sys.stderr)
                return 14

        try:
            if args.execute:
                survey_scanner, discovery, records = (
                    await start_live_target_record_discovery(
                        policy=policy,
                        adapter=args.adapter,
                        discover_seconds=args.discover_seconds,
                        max_devices=args.max_devices,
                    )
                )
                scanner_lifecycle = {
                    "kept_active_through_execution": True,
                    "stop_attempted": False,
                    "stop_completed": False,
                    "error": None,
                }
            else:
                discovery = await discover_target_queue(
                    policy=policy,
                    adapter=args.adapter,
                    discover_seconds=args.discover_seconds,
                    max_devices=args.max_devices,
                )
                records = []

        except Exception as exc:
            if args.execute and lease_acquired:
                try:
                    latch_unsafe_stop(
                        args.safety_state_dir,
                        plan_id=survey_run_id,
                        reason=(
                            "active GATT survey discovery failed after RF start: "
                            f"{type(exc).__name__}: {exc}"
                        ),
                        cleanup={
                            "phase": "discovery",
                            "completed": False,
                            "error": f"{type(exc).__name__}: {exc}",
                        },
                        output_dir=args.output_dir,
                    )
                    lease_acquired = False
                except SafetyInterlockError as safety_exc:
                    print(
                        f"Survey safety latch error: {safety_exc}",
                        file=sys.stderr,
                    )
            print(
                f"Survey discovery error: {type(exc).__name__}: {exc}",
                file=sys.stderr,
            )
            return 10

        async def stop_active_survey_scanner():
            nonlocal survey_scanner, scanner_lifecycle

            if survey_scanner is None:
                return True

            scanner_lifecycle["stop_attempted"] = True
            try:
                await survey_scanner.stop()
            except Exception as exc:
                scanner_lifecycle["error"] = f"{type(exc).__name__}: {exc}"
                return False

            scanner_lifecycle["stop_completed"] = True
            survey_scanner = None
            return True

        if args.execute:
            try:
                normalized_authorization = validate_gatt_survey_authorization(
                    authorization,
                    target_addresses=discovery["targets"],
                    timeout_seconds=args.timeout,
                    max_targets=args.max_devices,
                    policy_mode=policy.mode,
                    scope_acknowledged=policy.acknowledge_scope,
                )
            except (ContractValidationError, TypeError, KeyError) as exc:
                safety_error = None
                scanner_safe = await stop_active_survey_scanner()

                if lease_acquired:
                    try:
                        if scanner_safe:
                            release_active_run(args.safety_state_dir)
                            lease_acquired = False
                        else:
                            latch_unsafe_stop(
                                args.safety_state_dir,
                                plan_id=survey_run_id,
                                reason=(
                                    "active GATT survey authorization failed "
                                    "and scanner cleanup was unconfirmed"
                                ),
                                cleanup={
                                    "phase": "scanner_stop",
                                    "completed": False,
                                    "error": scanner_lifecycle["error"],
                                },
                                output_dir=args.output_dir,
                            )
                            lease_acquired = False
                    except SafetyInterlockError as release_exc:
                        safety_error = release_exc

                manifest = {
                    "schema_version": "0.10.0",
                    "type": "kamal_gatt_survey_manifest",
                    "phase": "authorization_failed",
                    "adapter": args.adapter,
                    "policy": {
                        "mode": policy.mode,
                        "scope_acknowledged": policy.acknowledge_scope,
                        "allowlist_count": (
                            len(policy.allowlist)
                            if policy.allowlist is not None
                            else None
                        ),
                    },
                    "limits": {
                        "discover_seconds": args.discover_seconds,
                        "max_devices": args.max_devices,
                        "timeout": args.timeout,
                    },
                    "discovery": discovery,
                    "authorization": authorization_provenance,
                    "authorization_error": f"{type(exc).__name__}: {exc}",
                    "execution_request": {
                        "path": "survey-execution-request.json",
                        "sha256": survey_request_sha256,
                    },
                    "scanner_lifecycle": scanner_lifecycle,
                    "safety_interlock": {
                        "state": (
                            "clear"
                            if scanner_safe and safety_error is None
                            else (
                                "recovery_required"
                                if not scanner_safe and safety_error is None
                                else "uncertain"
                            )
                        ),
                        "state_dir": str(args.safety_state_dir.resolve()),
                        "error": (
                            None
                            if safety_error is None
                            else f"{type(safety_error).__name__}: {safety_error}"
                        ),
                    },
                }
                try:
                    atomic_json_write(manifest_path, manifest)
                except OSError as output_exc:
                    print(f"Survey output error: {output_exc}", file=sys.stderr)
                if safety_error is not None:
                    print(f"Survey safety error: {safety_error}", file=sys.stderr)
                    return 14
                if not scanner_safe:
                    print(
                        "Survey safety error: scanner cleanup was not confirmed",
                        file=sys.stderr,
                    )
                    return 14
                print(f"Survey authorization error: {exc}", file=sys.stderr)
                return 9

        manifest = {
            "schema_version": "0.10.0",
            "type": "kamal_gatt_survey_manifest",
            "phase": "executing" if args.execute else "discovery_only",
            "adapter": args.adapter,
            "policy": {
                "mode": policy.mode,
                "scope_acknowledged": policy.acknowledge_scope,
                "allowlist_count": (
                    len(policy.allowlist)
                    if policy.allowlist is not None
                    else None
                ),
            },
            "limits": {
                "discover_seconds": args.discover_seconds,
                "max_devices": args.max_devices,
                "timeout": args.timeout,
            },
            "discovery": discovery,
        }

        if args.execute:
            manifest["authorization"] = {
                **authorization_provenance,
                "engagement_id": normalized_authorization["engagement_id"],
                "operator": normalized_authorization["operator"],
                "owner": normalized_authorization["owner"],
                "location": normalized_authorization["location"],
                "not_before_utc": normalized_authorization["not_before_utc"],
                "expires_at_utc": normalized_authorization["expires_at_utc"],
            }
            manifest["execution_request"] = {
                "path": "survey-execution-request.json",
                "sha256": survey_request_sha256,
            }
            manifest["scanner_lifecycle"] = scanner_lifecycle
            manifest["safety_interlock"] = {
                "state": "active",
                "state_dir": str(args.safety_state_dir.resolve()),
                "error": None,
            }

        def checkpoint(
            outcomes,
            abort_error=None,
            final=False,
            abort_cleanup_confirmed=False,
        ):
            manifest["execution"] = build_execution_manifest(
                len(records),
                outcomes,
                abort_error=abort_error,
                abort_cleanup_confirmed=abort_cleanup_confirmed,
            )

            if abort_error is not None:
                manifest["phase"] = "aborted"
            elif final:
                manifest["phase"] = (
                    "completed"
                    if (
                        manifest["execution"]["complete"]
                        and (
                            manifest.get("safety_interlock", {})
                            .get("state")
                            == "clear"
                        )
                    )
                    else "stopped_unsafe"
                )
            else:
                manifest["phase"] = "executing"

            atomic_json_write(manifest_path, manifest)

        try:
            if not args.execute:
                atomic_json_write(manifest_path, manifest)
                print(json.dumps(manifest, indent=2, sort_keys=True))
                return 0

            # Initial checkpoint exists before the first connection.
            checkpoint([])

            async def inspect_record(record):
                validate_gatt_survey_authorization(
                    authorization,
                    target_addresses=[record["address"]],
                    timeout_seconds=args.timeout,
                    max_targets=1,
                    policy_mode=policy.mode,
                    scope_acknowledged=policy.acknowledge_scope,
                )
                return await inspect_discovered_device(
                    device=record["device"],
                    adv=record["advertisement"],
                    adapter=args.adapter,
                    timeout=args.timeout,
                    registries=registries,
                    provenance=provenance,
                    authorization_provenance=authorization_provenance,
                )

            try:
                outcomes = await run_survey_records(
                    records,
                    inspect_record,
                    output_dir=args.output_dir,
                    on_outcome=checkpoint,
                )
            except SurveyAbortedError as exc:
                abort_cleanup_confirmed = isinstance(
                    exc.cause, ContractValidationError
                )
                current_outcome = None
                if exc.outcomes and exc.outcomes[-1]["address"] == exc.address:
                    current_outcome = exc.outcomes[-1]
                    abort_cleanup_confirmed = cleanup_is_safe(
                        current_outcome["report"]
                    )

                scanner_safe = await stop_active_survey_scanner()
                abort_cleanup_confirmed = (
                    abort_cleanup_confirmed and scanner_safe
                )

                try:
                    if abort_cleanup_confirmed:
                        release_active_run(args.safety_state_dir)
                        lease_acquired = False
                        manifest["safety_interlock"] = {
                            "state": "clear",
                            "state_dir": str(args.safety_state_dir.resolve()),
                            "error": None,
                        }
                    else:
                        cleanup = (
                            {
                                "phase": "scanner_stop",
                                "completed": False,
                                "error": scanner_lifecycle["error"],
                            }
                            if not scanner_safe
                            else (
                                current_outcome["report"].get("disconnect")
                                if current_outcome is not None
                                else {
                                    "phase": "survey_abort",
                                    "completed": False,
                                    "error": (
                                        f"{type(exc.cause).__name__}: {exc.cause}"
                                    ),
                                }
                            )
                        )
                        reason = (
                            "active GATT survey aborted with unconfirmed cleanup: "
                            f"{type(exc.cause).__name__}: {exc.cause}"
                        )
                        if not scanner_safe:
                            reason += (
                                "; scanner cleanup failed: "
                                f"{scanner_lifecycle['error']}"
                            )
                        latch_unsafe_stop(
                            args.safety_state_dir,
                            plan_id=survey_run_id,
                            reason=reason,
                            cleanup=cleanup,
                            output_dir=args.output_dir,
                            current_target={
                                "address": exc.address,
                                "address_type": "unknown",
                            },
                        )
                        lease_acquired = False
                        manifest["safety_interlock"] = {
                            "state": "recovery_required",
                            "state_dir": str(args.safety_state_dir.resolve()),
                            "error": None,
                        }
                except SafetyInterlockError as safety_exc:
                    manifest["safety_interlock"] = {
                        "state": "uncertain",
                        "state_dir": str(args.safety_state_dir.resolve()),
                        "error": f"{type(safety_exc).__name__}: {safety_exc}",
                    }

                checkpoint(
                    exc.outcomes,
                    abort_error=exc,
                    abort_cleanup_confirmed=abort_cleanup_confirmed,
                )
                print(
                    f"Survey aborted: {exc}",
                    file=sys.stderr,
                )
                return 13

            unsafe_outcome = next(
                (
                    outcome
                    for outcome in outcomes
                    if not cleanup_is_safe(outcome["report"])
                ),
                None,
            )
            scanner_safe = await stop_active_survey_scanner()

            try:
                if not scanner_safe:
                    latch_unsafe_stop(
                        args.safety_state_dir,
                        plan_id=survey_run_id,
                        reason=(
                            "active GATT survey scanner cleanup was not confirmed: "
                            f"{scanner_lifecycle['error']}"
                        ),
                        cleanup={
                            "phase": "scanner_stop",
                            "completed": False,
                            "error": scanner_lifecycle["error"],
                        },
                        output_dir=args.output_dir,
                    )
                    lease_acquired = False
                    manifest["safety_interlock"] = {
                        "state": "recovery_required",
                        "state_dir": str(args.safety_state_dir.resolve()),
                        "error": None,
                    }
                elif unsafe_outcome is not None:
                    latch_unsafe_stop(
                        args.safety_state_dir,
                        plan_id=survey_run_id,
                        reason="active GATT survey stopped after unconfirmed cleanup",
                        cleanup=unsafe_outcome["report"].get("disconnect"),
                        output_dir=args.output_dir,
                        current_target={
                            "address": unsafe_outcome["address"],
                            "address_type": "unknown",
                        },
                    )
                    lease_acquired = False
                    manifest["safety_interlock"] = {
                        "state": "recovery_required",
                        "state_dir": str(args.safety_state_dir.resolve()),
                        "error": None,
                    }
                else:
                    release_active_run(args.safety_state_dir)
                    lease_acquired = False
                    manifest["safety_interlock"] = {
                        "state": "clear",
                        "state_dir": str(args.safety_state_dir.resolve()),
                        "error": None,
                    }
            except SafetyInterlockError as exc:
                manifest["safety_interlock"] = {
                    "state": "uncertain",
                    "state_dir": str(args.safety_state_dir.resolve()),
                    "error": f"{type(exc).__name__}: {exc}",
                }
                checkpoint(outcomes, final=True)
                print(f"Survey safety error: {exc}", file=sys.stderr)
                return 14

            checkpoint(outcomes, final=True)

        except (OSError, TypeError, ValueError) as exc:
            print(f"Survey output error: {exc}", file=sys.stderr)
            return 11

        print(json.dumps(manifest, indent=2, sort_keys=True))

        execution = manifest["execution"]
        if (
            manifest.get("phase") != "completed"
            or manifest.get("safety_interlock", {}).get("state") != "clear"
            or not execution["complete"]
            or execution["failed_count"] != 0
        ):
            return 12

        return 0

    try:
        registries, provenance = load_gatt_registries()
    except (OSError, ValueError, KeyError, TypeError) as exc:
        print(
            f"GATT registry error: {exc}. "
            "See data/bluetooth/README.md for generation instructions.",
            file=sys.stderr,
        )
        return 7

    report, status = await inspect_target(
        target=args.target,
        adapter=args.adapter,
        timeout=args.timeout,
        registries=registries,
        provenance=provenance,
    )

    output = json.dumps(report, indent=2, sort_keys=True)

    if args.json_path:
        with open(args.json_path, "w", encoding="utf-8") as handle:
            handle.write(output)
            handle.write("\n")
    else:
        print(output)

    return status


def main():
    try:
        status = asyncio.run(async_main())
    except KeyboardInterrupt:
        return 130

    return status


if __name__ == "__main__":
    sys.exit(main())
