#!/usr/bin/env bash
#
# K'amal Radio Capture Interface
#
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Maxine Filcher
#

set -Eeuo pipefail

VERSION="0.2.2"
CAPTURE_ROOT="${KAMAL_CAPTURE_ROOT:-$HOME/captures}"
BLE_DEVICE="/dev/kamal-ble-sniffer"

log() { printf '[Kamal] %s\n' "$*"; }
warn() { printf '[Kamal] WARNING: %s\n' "$*" >&2; }
die() { printf '[Kamal] ERROR: %s\n' "$*" >&2; exit 1; }
require_command() {
    command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

usage() {
    cat <<EOF
K'amal Capture v${VERSION}

Usage:
    kamal-capture list
    kamal-capture ble [options]

BLE options:
    --duration SECONDS      Stop after SECONDS (positive integer).
    --name NAME             Follow an advertiser by name.
    --address ADDRESS       Follow an advertiser by address.
    --output FILE           Write PCAP to FILE (default: dated capture directory).
    --advertising-only      Capture advertising traffic only.
    -h, --help              Show this help.

Examples:
    kamal-capture list
    kamal-capture ble --duration 60
    kamal-capture ble --name Sensor
    kamal-capture ble --address AA:BB:CC:DD:EE:FF
    kamal-capture ble --duration 300 --output test.pcap
EOF
}

radio_list() {
    local controller="" resolved="" state=""
    printf "K'amal Radio Inventory\n======================\n\n"
    printf 'BLE Control\n'
    if command -v bluetoothctl >/dev/null 2>&1; then
        controller="$(bluetoothctl list 2>/dev/null | head -1 || true)"
        if [[ -n "$controller" ]]; then
            printf '  %-12s %s\n' 'Status:' 'READY' 'Controller:' "$controller"
        else
            printf '  %-12s %s\n' 'Status:' 'NOT FOUND'
        fi
    else
        printf '  %-12s %s\n' 'Status:' 'UNKNOWN'
    fi

    printf '\nBLE Capture\n'
    if [[ -e "$BLE_DEVICE" ]]; then
        resolved="$(readlink -e "$BLE_DEVICE" || true)"
        printf '  %-12s %s\n' 'Status:' 'READY' 'Device:' "$BLE_DEVICE" 'Port:' "${resolved:-unknown}"
    else
        printf '  %-12s %s\n' 'Status:' 'NOT FOUND'
    fi

    printf '\nCellular\n'
    if [[ -d /sys/class/net/wwan0 ]]; then
        state="$(cat /sys/class/net/wwan0/operstate 2>/dev/null || true)"
        printf '  %-12s %s\n' 'Interface:' 'wwan0' 'State:' "${state:-unknown}"
    else
        printf '  %-12s %s\n' 'Status:' 'NOT FOUND'
    fi
}

capture_ble() {
    local duration="" target_name="" target_address="" output="" advertising_only=false
    local port="" date_dir="" timestamp="" hostname="" capture_dir="" metadata_file=""
    local start_ns="" end_ns="" start_time="" end_time="" wall_duration=""
    local packet_count="" pcap_duration="" file_size="" size_bytes="" sha256="" encapsulation=""
    local radio_serial="" capinfo="" timestamp_analysis=""
    local timestamps_monotonic="" largest_timestamp_gap="" largest_timestamp_gap_frame=""
    local timestamp_discontinuity="" timestamp_span_anomalous="" rc=0
    local -a cmd

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --duration|--name|--address|--output)
                [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value."
                case "$1" in
                    --duration) duration="$2" ;;
                    --name) target_name="$2" ;;
                    --address) target_address="$2" ;;
                    --output) output="$2" ;;
                esac
                shift 2
                ;;
            --advertising-only) advertising_only=true; shift ;;
            -h|--help) usage; return 0 ;;
            *) die "Unknown BLE option: $1" ;;
        esac
    done

    for dependency in nrfutil python3 capinfos tshark udevadm timeout stat awk sha256sum readlink date hostname mkdir; do
        require_command "$dependency"
    done

    [[ -e "$BLE_DEVICE" ]] || die "BLE capture radio not found: $BLE_DEVICE"
    port="$(readlink -e "$BLE_DEVICE")"
    [[ -n "$port" ]] || die "Unable to resolve $BLE_DEVICE"

    if [[ -n "$duration" ]]; then
        [[ "$duration" =~ ^[0-9]+$ ]] || die 'Duration must be a positive integer number of seconds.'
        [[ "$duration" =~ [1-9] ]] || die 'Duration must be greater than zero.'
    fi
    [[ -z "$target_name" || -z "$target_address" ]] || die '--name and --address cannot currently be used together.'

    date_dir="$(date +%Y-%m-%d)"
    timestamp="$(date +%H%M%S)"
    hostname="$(hostname -s)"
    capture_dir="${CAPTURE_ROOT}/ble/${date_dir}"

    if [[ -z "$output" ]]; then
        mkdir -p "$capture_dir"
        output="${capture_dir}/${hostname}_ble_${timestamp}.pcap"
    elif [[ "$output" != /* ]]; then
        output="${PWD}/${output}"
    fi
    metadata_file="${output%.*}.json"
    [[ ! -e "$output" && ! -L "$output" ]] || die "Output file already exists: $output"
    [[ ! -e "$metadata_file" && ! -L "$metadata_file" ]] || die "Metadata file already exists: $metadata_file"
    [[ -d "$(dirname "$output")" ]] || die "Output directory does not exist: $(dirname "$output")"

    cmd=(nrfutil ble-sniffer sniff --port "$port" --output-pcap-file "$output")
    [[ -z "$target_name" ]] || cmd+=(--follow-by-name "$target_name")
    [[ -z "$target_address" ]] || cmd+=(--follow-by-address "$target_address")
    [[ "$advertising_only" != true ]] || cmd+=(--advertising-only)

    printf "\nK'amal BLE Capture\n==================\n\n"
    printf 'Radio:       %s\nPort:        %s\nOutput:      %s\n' "$BLE_DEVICE" "$port" "$output"
    if [[ -n "$duration" ]]; then
        printf 'Duration:    %s seconds\n' "$duration"
    else
        printf 'Duration:    until Ctrl-C\n'
    fi
    [[ -z "$target_name" ]] || printf 'Target name: %s\n' "$target_name"
    [[ -z "$target_address" ]] || printf 'Target addr: %s\n' "$target_address"
    [[ "$advertising_only" != true ]] || printf 'Mode:        advertising only\n'
    printf '\n'

    start_time="$(date --iso-8601=seconds)"
    start_ns="$(date +%s%N)"
    if [[ -n "$duration" ]]; then
        # Handle timeout without disabling errexit globally.
        rc=0
        timeout --signal=INT --kill-after=5s "$duration" "${cmd[@]}" || rc=$?
        if [[ "$rc" -ne 0 && "$rc" -ne 124 ]]; then
            die "BLE capture failed with exit code $rc"
        fi
    else
        "${cmd[@]}"
    fi
    end_ns="$(date +%s%N)"
    end_time="$(date --iso-8601=seconds)"
    wall_duration="$(awk -v start="$start_ns" -v end="$end_ns" 'BEGIN {printf "%.3f", (end-start)/1000000000}')"

    [[ -s "$output" ]] || die 'Capture file was not created or is empty.'
    capinfo="$(capinfos "$output")" || die 'capinfos could not read the capture.'
    packet_count="$(awk -F: '/Number of packets:/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' <<< "$capinfo")"
    pcap_duration="$(awk -F: '/Capture duration:/ {gsub(/^[ \t]+/, "", $2); sub(/[[:space:]]+seconds$/, "", $2); print $2; exit}' <<< "$capinfo")"
    file_size="$(awk -F: '/File size:/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' <<< "$capinfo")"
    encapsulation="$(awk -F: '/File encapsulation:/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' <<< "$capinfo")"
    size_bytes="$(stat -c '%s' "$output")"
    sha256="$(sha256sum "$output" | awk '{print $1}')"

    [[ "$packet_count" =~ ^[0-9]+$ ]] || die 'Unable to determine packet count.'
    [[ "$pcap_duration" =~ ^[0-9]+([.][0-9]+)?$ ]] || die 'Unable to determine PCAP timestamp span.'
    [[ "$size_bytes" =~ ^[0-9]+$ ]] || die 'Unable to determine file size.'
    [[ "$sha256" =~ ^[[:xdigit:]]{64}$ ]] || die 'Unable to determine SHA-256.'
    [[ -n "$encapsulation" ]] || die 'Unable to determine capture encapsulation.'

    radio_serial="$(udevadm info --query=property --name="$port" 2>/dev/null | sed -n 's/^ID_SERIAL_SHORT=//p' || true)"

    # Collect all timestamp integrity metrics in a single tshark pass.
    # AWK uses numeric coercion on timestamps, but preserves the frame number.
    # The tshark exit status is checked separately: a failed analysis is not
    # misreported as a healthy capture.
    local timestamps_file=""
    timestamps_file="$(mktemp)" || die 'Unable to create temporary timestamp file.'
    if ! tshark -r "$output" -T fields -e frame.number -e frame.time_epoch > "$timestamps_file"; then
        rm -f "$timestamps_file"
        die 'tshark timestamp analysis failed.'
    fi
    timestamp_analysis="$(awk '
        NF >= 2 {
            frame=$1; current=$2+0
            if (seen) {
                delta=current-previous
                if (delta < 0) monotonic=0
                if (!have_gap || delta > max_gap) {
                    max_gap=delta; max_frame=frame; have_gap=1
                }
            } else { monotonic=1 }
            previous=current; seen=1
        }
        END {
            if (!seen) exit 2
            if (!have_gap) {max_gap=0; max_frame=0}
            printf "%s %.9f %s\n", monotonic ? "true" : "false", max_gap, max_frame
        }
    ' "$timestamps_file")" || { rm -f "$timestamps_file"; die 'No packet timestamps available for analysis.'; }
    rm -f "$timestamps_file"
    read -r timestamps_monotonic largest_timestamp_gap largest_timestamp_gap_frame <<< "$timestamp_analysis"
    [[ "$timestamps_monotonic" == true || "$timestamps_monotonic" == false ]] || die 'Invalid timestamp analysis result.'
    [[ "$largest_timestamp_gap" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || die 'Invalid timestamp gap.'
    [[ "$largest_timestamp_gap_frame" =~ ^[0-9]+$ ]] || die 'Invalid timestamp gap frame.'

    timestamp_discontinuity="$(awk -v gap="$largest_timestamp_gap" -v wall="$wall_duration" 'BEGIN {print (gap > wall) ? "true" : "false"}')"
    timestamp_span_anomalous="$(awk -v span="$pcap_duration" -v wall="$wall_duration" 'BEGIN {print (span > wall + 1.0) ? "true" : "false"}')"

    # Pass untrusted strings as arguments; Python performs JSON escaping.
    # Exclusive creation prevents silently overwriting existing sidecars.
    python3 - \
        "$metadata_file" "$output" "$hostname" "$start_time" "$end_time" \
        "$duration" "$wall_duration" "$BLE_DEVICE" "$port" "$radio_serial" \
        "$packet_count" "$size_bytes" "$encapsulation" "$pcap_duration" \
        "$timestamps_monotonic" "$largest_timestamp_gap" "$largest_timestamp_gap_frame" \
        "$timestamp_discontinuity" "$timestamp_span_anomalous" "$sha256" \
        "$target_name" "$target_address" "$advertising_only" <<'PY'
import json
import os
import sys

(
    metadata_file, capture_file, hostname, start_time, end_time,
    requested_duration, wall_duration, radio_device, resolved_device,
    radio_serial, packet_count, size_bytes, encapsulation, timestamp_span,
    timestamps_monotonic, largest_timestamp_gap, largest_timestamp_gap_frame,
    timestamp_discontinuity, timestamp_span_anomalous, sha256,
    target_name, target_address, advertising_only,
) = sys.argv[1:]

metadata = {
    "schema_version": "1.0",
    "capture": {
        "type": "ble",
        "hostname": hostname,
        "start_time": start_time,
        "end_time": end_time,
        "requested_duration_seconds": int(requested_duration) if requested_duration else None,
        "wall_duration_seconds": float(wall_duration),
        "packet_count": int(packet_count),
    },
    "radio": {
        "role": "ble-sniffer",
        "device": radio_device,
        "resolved_device": resolved_device,
        "serial": radio_serial or None,
        "hardware": "Nordic nRF52840 Dongle",
        "board": "PCA10059",
    },
    "pcap": {
        "file": os.path.basename(capture_file),
        "size_bytes": int(size_bytes),
        "encapsulation": encapsulation,
        "timestamp_span_seconds": float(timestamp_span),
        "timestamps_monotonic": timestamps_monotonic == "true",
        "largest_timestamp_gap_seconds": float(largest_timestamp_gap),
        "largest_timestamp_gap_frame": int(largest_timestamp_gap_frame),
        "timestamp_discontinuity_detected": timestamp_discontinuity == "true",
        "timestamp_span_anomalous": timestamp_span_anomalous == "true",
        "sha256": sha256,
    },
    "filters": {
        "name": target_name or None,
        "address": target_address or None,
        "advertising_only": advertising_only == "true",
    },
}

with open(metadata_file, "x", encoding="utf-8") as handle:
    json.dump(metadata, handle, indent=2)
    handle.write("\n")
PY

    printf '\nCapture complete.\n\n'
    printf 'Wall duration:             %s seconds\n' "$wall_duration"
    printf 'Packets:                   %s\n' "$packet_count"
    printf 'File size:                 %s\n' "${file_size:-${size_bytes} bytes}"
    printf 'PCAP timestamp span:       %s seconds\n' "$pcap_duration"
    printf 'Timestamps monotonic:      %s\n' "$timestamps_monotonic"
    printf 'Largest timestamp gap:     %s seconds (frame %s)\n' "$largest_timestamp_gap" "$largest_timestamp_gap_frame"
    printf 'Timestamp discontinuity:   %s\n' "$timestamp_discontinuity"
    printf 'Timestamp span anomalous:  %s\n' "$timestamp_span_anomalous"
    printf 'SHA256:                    %s\n' "$sha256"
    printf 'Metadata:                  %s\n' "$metadata_file"
    printf '\nSaved:\n%s\n' "$output"
}

main() {
    [[ $# -gt 0 ]] || { usage; exit 1; }
    case "$1" in
        list) shift; [[ $# -eq 0 ]] || die 'list takes no arguments.'; radio_list ;;
        ble) shift; capture_ble "$@" ;;
        version|--version) printf 'kamal-capture %s\n' "$VERSION" ;;
        help|-h|--help) usage ;;
        *) die "Unknown capture type: $1" ;;
    esac
}

main "$@"
