#!/usr/bin/env python3
"""Build a hash-bound explicit Bluetooth pairing plan without RF activity."""

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from kamal.active_contracts import load_json_source  # noqa: E402
from kamal.evidence_contracts import atomic_create_json  # noqa: E402
from kamal.pairing_contracts import (  # noqa: E402
    PairingContractError,
    build_pairing_plan,
)


def parser():
    result = argparse.ArgumentParser(
        description=(
            "Validate exact-target pairing authorization and build a pairing plan. "
            "This command performs no Bluetooth RF operations."
        )
    )
    result.add_argument("--authorization", required=True, type=Path)
    result.add_argument("--request", required=True, type=Path)
    result.add_argument("--json", required=True, type=Path)
    return result


def _same_path(left, right):
    try:
        return left.resolve() == right.resolve() or left.samefile(right)
    except (FileNotFoundError, OSError):
        return left.resolve() == right.resolve()


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        authorization, authorization_sha256, authorization_path = load_json_source(
            args.authorization
        )
        request, request_sha256, request_path = load_json_source(args.request)
        output_path = args.json.resolve()
        for source_path in (authorization_path, request_path):
            if _same_path(output_path, source_path):
                raise PairingContractError(
                    "output path must not overwrite an input artifact"
                )
        plan = build_pairing_plan(
            authorization,
            request,
            authorization_sha256=authorization_sha256,
            request_sha256=request_sha256,
        )
        atomic_create_json(args.json, plan)
    except (OSError, PairingContractError, ValueError, TypeError, KeyError) as exc:
        print(f"kamal-plan-pairing: {exc}", file=sys.stderr)
        return 1

    print(f"Bluetooth pairing plan written to {args.json}")
    print("No RF operations were performed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
