#!/usr/bin/env python3
"""Offline BLE intelligence enrichment for K'amal assessments."""

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from kamal.device_intelligence import (  # noqa: E402
    build_ble_intelligence_enrichment,
    load_assessment_source,
    load_intelligence_catalog,
)
from kamal.evidence_contracts import AtomicCreateError, atomic_create_json  # noqa: E402


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description=(
            "Enrich an existing K'amal BLE assessment from a local, "
            "provenance-bearing intelligence catalog. No RF operations occur."
        )
    )
    parser.add_argument("--assessment", required=True, type=Path)
    parser.add_argument("--catalog", required=True, type=Path)
    parser.add_argument(
        "--json",
        required=True,
        type=Path,
        help="new enrichment JSON output; existing files are never replaced",
    )
    return parser.parse_args(argv)


def _protect_inputs(inputs, output):
    output_resolved = output.resolve()
    for source in inputs:
        if output_resolved == source.resolve():
            raise ValueError("Output path must not overwrite an input")
        if output.exists() and source.exists() and output.samefile(source):
            raise ValueError("Output path must not alias an input")


def main(argv=None):
    args = parse_args(argv)
    try:
        _protect_inputs((args.assessment, args.catalog), args.json)
        assessment_source = load_assessment_source(args.assessment)
        catalog_source = load_intelligence_catalog(args.catalog)
        result = build_ble_intelligence_enrichment(
            assessment_source,
            catalog_source,
        )
        atomic_create_json(args.json, result)
    except AtomicCreateError as exc:
        if exc.published:
            print(
                f"Enrichment artifact exists at {exc.path}, but directory "
                f"durability was not confirmed: {exc}",
                file=sys.stderr,
            )
        else:
            print(f"Enrichment persistence failed: {exc}", file=sys.stderr)
        return 1
    except (OSError, ValueError, TypeError, KeyError) as exc:
        print(f"Enrichment failed: {exc}", file=sys.stderr)
        return 1

    print(f"Enrichment written: {args.json}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
