#!/usr/bin/env python3

import argparse
import asyncio
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from bleak import BleakClient, BleakScanner

from kamal.gatt_report import new_report, serialize_services
from kamal.identifiers import load_registry


REGISTRY_FILES = {
    "service": "service_uuids.json",
    "characteristic": "characteristic_uuids.json",
    "descriptor": "descriptor_uuids.json",
}


def load_gatt_registries():
    """Load the three required offline Bluetooth SIG registries."""
    registries = {
        namespace: load_registry(filename)
        for namespace, filename in REGISTRY_FILES.items()
    }

    revisions = {
        registry["source_commit"]
        for registry in registries.values()
    }
    if len(revisions) != 1:
        raise ValueError("GATT registries use different source revisions")

    provenance = {
        "source": "Bluetooth SIG Assigned Numbers",
        "source_commit": revisions.pop(),
        "registries": {
            namespace: {
                "file": REGISTRY_FILES[namespace],
                "source_file": registry["source_file"],
                "generated_at_utc": registry["generated_at_utc"],
            }
            for namespace, registry in registries.items()
        },
    }

    return registries, provenance


async def find_target(target, adapter, timeout):
    devices = await BleakScanner.discover(
        timeout=timeout,
        return_adv=True,
        bluez={"adapter": adapter},
    )

    target_normalized = target.upper()

    for address, (device, adv) in devices.items():
        if address.upper() == target_normalized:
            return device, adv

    return None, None


async def inspect_target(target, adapter, timeout, registries=None, provenance=None):
    report = new_report(target, adapter)
    if provenance is not None:
        report["identifier_resolution"] = provenance

    try:
        device, adv = await find_target(target, adapter, timeout)
    except Exception as exc:
        report["discovery"] = {
            "attempted": True,
            "found": False,
            "error": f"{type(exc).__name__}: {exc}",
        }
        return report, 2

    if device is None:
        report["discovery"] = {
            "attempted": True,
            "found": False,
            "error": None,
        }
        return report, 3

    report["discovery"] = {
        "attempted": True,
        "found": True,
        "error": None,
        "name": device.name,
        "address": device.address,
        "rssi": adv.rssi,
        "advertised_service_uuids": list(adv.service_uuids),
    }

    report["connection"]["attempted"] = True

    try:
        client = BleakClient(
            device,
            timeout=timeout,
            pair=False,
        )
    except Exception as exc:
        report["connection"]["error"] = f"{type(exc).__name__}: {exc}"
        return report, 4

    status = 0

    try:
        try:
            await client.connect()
            report["connection"]["connected"] = client.is_connected

            if not client.is_connected:
                report["connection"]["error"] = (
                    "BleakClient.connect() returned without connected state"
                )
                status = 4

        except Exception as exc:
            report["connection"]["error"] = f"{type(exc).__name__}: {exc}"
            status = 4

        if status == 0:
            report["gatt"]["enumeration_attempted"] = True

            try:
                report["gatt"]["services"] = serialize_services(client.services, registries)
                report["gatt"]["enumerated"] = True
            except Exception as exc:
                report["gatt"]["error"] = f"{type(exc).__name__}: {exc}"
                status = 5

    finally:
        # Cleanup even if connect() failed or returned without connecting.
        report["disconnect"]["attempted"] = True

        try:
            await client.disconnect()
            report["disconnect"]["completed"] = not client.is_connected

            if not report["disconnect"]["completed"]:
                report["disconnect"]["error"] = (
                    "BleakClient.disconnect() returned while still connected"
                )

        except Exception as exc:
            report["disconnect"]["error"] = f"{type(exc).__name__}: {exc}"

    if report["disconnect"]["error"] is not None and status == 0:
        status = 6

    return report, status


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Read-only active BLE GATT enumeration for K'amal."
    )
    commands = parser.add_subparsers(dest="command", required=True)

    inspect = commands.add_parser("inspect")
    inspect.add_argument("target", help="BLE target address")
    inspect.add_argument("--adapter", default="hci0")
    inspect.add_argument("--timeout", type=float, default=10.0)
    inspect.add_argument("--json", dest="json_path")

    survey = commands.add_parser("survey")
    targeting = survey.add_mutually_exclusive_group(required=True)
    targeting.add_argument("--allowlist", type=Path)
    targeting.add_argument("--all-discovered", action="store_true")
    survey.add_argument("--acknowledge-scope", action="store_true")
    survey.add_argument("--adapter", default="hci0")
    survey.add_argument(
        "--discover-seconds",
        type=float,
        default=30.0,
        help="Discovery duration in seconds (default: 30, max: 60)",
    )
    survey.add_argument(
        "--max-devices",
        type=int,
        default=50,
        help="Maximum permitted devices to queue (default: 50, max: 100)",
    )
    survey.add_argument("--output-dir", type=Path, required=True)

    return parser.parse_args(argv)


async def async_main(argv=None):
    args = parse_args(argv)

    if args.command == "survey":
        from kamal.gatt_survey import (
            SurveyTargetPolicy,
            discover_target_queue,
            validate_discovery_settings,
        )

        try:
            validate_discovery_settings(
                args.discover_seconds,
                args.max_devices,
            )

            if args.all_discovered:
                policy = SurveyTargetPolicy(
                    mode="all_discovered",
                    acknowledge_scope=args.acknowledge_scope,
                )
            else:
                if args.acknowledge_scope:
                    raise ValueError(
                        "Scope acknowledgment is only valid for all-discovered mode"
                    )

                targets = json.loads(
                    args.allowlist.read_text(encoding="utf-8")
                )

                if not isinstance(targets, list):
                    raise ValueError("Allowlist must be a JSON array")

                policy = SurveyTargetPolicy(
                    mode="allowlist",
                    allowlist=frozenset(targets),
                )

            args.output_dir.mkdir(parents=True, exist_ok=True)

        except (OSError, ValueError, TypeError) as exc:
            print(f"Survey policy error: {exc}", file=sys.stderr)
            return 8

        try:
            discovery = await discover_target_queue(
                policy=policy,
                adapter=args.adapter,
                discover_seconds=args.discover_seconds,
                max_devices=args.max_devices,
            )
        except Exception as exc:
            print(
                f"Survey discovery error: {type(exc).__name__}: {exc}",
                file=sys.stderr,
            )
            return 10

        manifest = {
            "schema_version": "0.10.0",
            "type": "kamal_gatt_survey_manifest",
            "phase": "discovery_only",
            "adapter": args.adapter,
            "policy": {
                "mode": policy.mode,
                "scope_acknowledged": policy.acknowledge_scope,
                "allowlist_count": (
                    len(policy.allowlist)
                    if policy.allowlist is not None
                    else None
                ),
            },
            "limits": {
                "discover_seconds": args.discover_seconds,
                "max_devices": args.max_devices,
            },
            "discovery": discovery,
        }

        manifest_path = args.output_dir / "survey-manifest.json"

        try:
            manifest_path.write_text(
                json.dumps(manifest, indent=2, sort_keys=True) + "\n",
                encoding="utf-8",
            )
        except OSError as exc:
            print(f"Survey output error: {exc}", file=sys.stderr)
            return 11

        print(json.dumps(manifest, indent=2, sort_keys=True))
        return 0

    try:
        registries, provenance = load_gatt_registries()
    except (OSError, ValueError, KeyError, TypeError) as exc:
        print(
            f"GATT registry error: {exc}. "
            "See data/bluetooth/README.md for generation instructions.",
            file=sys.stderr,
        )
        return 7

    report, status = await inspect_target(
        target=args.target,
        adapter=args.adapter,
        timeout=args.timeout,
        registries=registries,
        provenance=provenance,
    )

    output = json.dumps(report, indent=2, sort_keys=True)

    if args.json_path:
        with open(args.json_path, "w", encoding="utf-8") as handle:
            handle.write(output)
            handle.write("\n")
    else:
        print(output)

    return status


def main():
    try:
        status = asyncio.run(async_main())
    except KeyboardInterrupt:
        return 130

    return status


if __name__ == "__main__":
    sys.exit(main())
