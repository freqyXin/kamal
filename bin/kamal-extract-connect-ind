#!/usr/bin/env python3
"""Extract directly observed legacy BLE CONNECT_IND evidence from an existing PCAP."""

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from kamal.ble_connection_extractor import (  # noqa: E402
    BLEConnectionExtractionError,
    extract_legacy_connect_ind_report,
)
from kamal.evidence_contracts import AtomicCreateError, atomic_create_json  # noqa: E402


def parser():
    result = argparse.ArgumentParser(
        description=(
            "Extract CRC-valid legacy BLE CONNECT_IND evidence from an existing "
            "PCAP using TShark. No RF or network operations are performed."
        )
    )
    result.add_argument("--pcap", required=True, type=Path)
    result.add_argument("--json", required=True, type=Path)
    result.add_argument(
        "--tshark",
        default="tshark",
        help="TShark executable/path (default: tshark)",
    )
    result.add_argument(
        "--nordic-control-log",
        type=Path,
        help=(
            "Optional retained nRF Util extcap control log containing Nordic's "
            "native CONNECT_REQ decode for explicit field reconciliation"
        ),
    )
    return result


def main(argv=None):
    args = parser().parse_args(argv)

    if args.json.exists() or args.json.is_symlink():
        print(
            f"kamal-extract-connect-ind: refusing to overwrite: {args.json}",
            file=sys.stderr,
        )
        return 1

    try:
        extract_kwargs = {"tshark": args.tshark}
        if args.nordic_control_log is not None:
            extract_kwargs["nordic_control_log"] = args.nordic_control_log
        report = extract_legacy_connect_ind_report(
            args.pcap,
            **extract_kwargs,
        )
        atomic_create_json(args.json, report)
    except AtomicCreateError as exc:
        if exc.published:
            print(
                "kamal-extract-connect-ind: artifact was published but parent "
                f"directory durability was not confirmed: {exc}",
                file=sys.stderr,
            )
        else:
            print(f"kamal-extract-connect-ind: {exc}", file=sys.stderr)
        return 1
    except (BLEConnectionExtractionError, OSError, ValueError, TypeError) as exc:
        print(f"kamal-extract-connect-ind: {exc}", file=sys.stderr)
        return 1

    summary = report["summary"]
    print(f"CONNECT_IND extraction report written: {args.json}")
    print(
        "Candidates: "
        f"{summary['candidate_count']} "
        f"accepted: {summary['accepted_count']} "
        f"rejected: {summary['rejected_count']}"
    )
    print("No RF or network operations were performed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
