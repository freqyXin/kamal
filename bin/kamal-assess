#!/usr/bin/env python3
"""Build a unified K'amal assessment from existing JSON reports."""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from kamal.assessment import build_assessment, load_source
from kamal.evidence_contracts import atomic_create_json
from kamal.catalog_provenance import (
    bind_bluetooth_snapshot,
    load_bluetooth_snapshot,
    sources_require_bluetooth_snapshot,
)


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Combine existing K'amal reports into an offline assessment."
    )
    parser.add_argument(
        "--assessment-id",
        required=True,
        help="Identifier for this assessment",
    )
    parser.add_argument(
        "--input",
        type=Path,
        action="append",
        required=True,
        help="Source JSON report; repeat for multiple reports",
    )
    parser.add_argument(
        "--bluetooth-snapshot",
        type=Path,
        help=(
            "Verified immutable Bluetooth SIG snapshot to pin into the assessment; "
            "no network access occurs"
        ),
    )
    parser.add_argument(
        "--json",
        type=Path,
        required=True,
        help="Output assessment JSON path",
    )
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)

    try:
        sources = [load_source(path) for path in args.input]
        requires_snapshot = sources_require_bluetooth_snapshot(sources)
        if requires_snapshot and args.bluetooth_snapshot is None:
            raise ValueError(
                "catalog-resolved BLE evidence requires --bluetooth-snapshot"
            )
        catalog_provenance = []
        if args.bluetooth_snapshot is not None:
            snapshot = load_bluetooth_snapshot(args.bluetooth_snapshot)
            catalog_provenance.append(
                bind_bluetooth_snapshot(snapshot, sources)
            )
        assessment = build_assessment(
            sources,
            assessment_id=args.assessment_id,
            catalog_provenance=catalog_provenance,
        )

        # Do not overwrite source reports, even if the output path
        # uses a different spelling of the same filesystem path.
        destination = args.json.resolve()
        for source in sources:
            source_path = Path(source["path"])
            if destination == source_path or (
                destination.exists()
                and destination.samefile(source_path)
            ):
                raise ValueError("Output path must not overwrite a source report")

        atomic_create_json(args.json, assessment)

    except (OSError, ValueError, TypeError, KeyError) as exc:
        print(f"Assessment error: {exc}", file=sys.stderr)
        return 1

    print(f"Assessment written: {args.json}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
