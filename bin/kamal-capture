#!/usr/bin/env bash
#
# K'amal Radio Capture Interface
#
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Maxine Filcher
#

set -Eeuo pipefail

VERSION="0.3.0"
CAPTURE_ROOT="${KAMAL_CAPTURE_ROOT:-$HOME/captures}"
BLE_DEVICE="${KAMAL_BLE_DEVICE:-/dev/kamal-ble-sniffer}"
BLE_ADV37_DEVICE="${KAMAL_BLE_ADV37_DEVICE:-/dev/kamal-ble-sniffer-37}"
BLE_ADV38_DEVICE="${KAMAL_BLE_ADV38_DEVICE:-/dev/kamal-ble-sniffer-38}"
BLE_ADV39_DEVICE="${KAMAL_BLE_ADV39_DEVICE:-/dev/kamal-ble-sniffer-39}"
FIXED_ADV_PRELOAD="${KAMAL_FIXED_ADV_PRELOAD:-/usr/local/lib/kamal/libkamal-nrf-fixed-adv.so}"

log() { printf '[Kamal] %s\n' "$*"; }
warn() { printf '[Kamal] WARNING: %s\n' "$*" >&2; }
die() { printf '[Kamal] ERROR: %s\n' "$*" >&2; exit 1; }
require_command() {
    command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

usage() {
    cat <<EOF
K'amal Capture v${VERSION}

Usage:
    kamal-capture list
    kamal-capture ble [options]
    kamal-capture ble-adv3 [options]

BLE options:
    --duration SECONDS      Stop after SECONDS (positive integer).
    --name NAME             Follow an advertiser by name.
    --address ADDRESS       Follow an advertiser by address.
    --output FILE           Write PCAP to FILE (default: dated capture directory).
    --advertising-only      Capture advertising traffic only.
    -h, --help              Show this help.

BLE three-channel advertising-plane options:
    --duration SECONDS      Concurrent steady-state capture duration (required).
    --address ADDRESS       Advertiser address to follow (required).
    --output-dir DIR        New directory for three PCAPs and manifest.
    --acquire-timeout SEC   Max seconds to wait for each follow request (default: 35).

Examples:
    kamal-capture list
    kamal-capture ble --duration 60
    kamal-capture ble --name Sensor
    kamal-capture ble --address AA:BB:CC:DD:EE:FF
    kamal-capture ble --duration 300 --output test.pcap
    kamal-capture ble-adv3 --address AA:BB:CC:DD:EE:FF --duration 60
EOF
}

radio_list() {
    local controller="" resolved="" state=""
    printf "K'amal Radio Inventory\n======================\n\n"
    printf 'BLE Control\n'
    if command -v bluetoothctl >/dev/null 2>&1; then
        controller="$(bluetoothctl list 2>/dev/null | head -1 || true)"
        if [[ -n "$controller" ]]; then
            printf '  %-12s %s\n' 'Status:' 'READY' 'Controller:' "$controller"
        else
            printf '  %-12s %s\n' 'Status:' 'NOT FOUND'
        fi
    else
        printf '  %-12s %s\n' 'Status:' 'UNKNOWN'
    fi

    printf '\nBLE Capture\n'
    if [[ -e "$BLE_DEVICE" ]]; then
        resolved="$(readlink -e "$BLE_DEVICE" || true)"
        printf '  %-12s %s\n' 'Status:' 'READY' 'Device:' "$BLE_DEVICE" 'Port:' "${resolved:-unknown}"
    else
        printf '  %-12s %s\n' 'Status:' 'NOT FOUND'
    fi

    printf '\nBLE Advertising Plane\n'
    local adv_device="" adv_channel=""
    for adv_channel in 37 38 39; do
        case "$adv_channel" in
            37) adv_device="$BLE_ADV37_DEVICE" ;;
            38) adv_device="$BLE_ADV38_DEVICE" ;;
            39) adv_device="$BLE_ADV39_DEVICE" ;;
        esac
        if [[ -e "$adv_device" ]]; then
            resolved="$(readlink -e "$adv_device" || true)"
            printf '  CH%-9s %s -> %s\n' "$adv_channel" "$adv_device" "${resolved:-unknown}"
        else
            printf '  CH%-9s %s\n' "$adv_channel" 'NOT FOUND'
        fi
    done

    printf '\nCellular\n'
    if [[ -d /sys/class/net/wwan0 ]]; then
        state="$(cat /sys/class/net/wwan0/operstate 2>/dev/null || true)"
        printf '  %-12s %s\n' 'Interface:' 'wwan0' 'State:' "${state:-unknown}"
    else
        printf '  %-12s %s\n' 'Status:' 'NOT FOUND'
    fi
}

capture_ble() {
    local duration="" target_name="" target_address="" output="" advertising_only=false
    local port="" date_dir="" timestamp="" hostname="" capture_dir="" metadata_file=""
    local start_ns="" end_ns="" start_time="" end_time="" wall_duration=""
    local packet_count="" pcap_duration="" file_size="" size_bytes="" sha256="" encapsulation=""
    local radio_serial="" capinfo="" timestamp_analysis=""
    local timestamps_monotonic="" largest_timestamp_gap="" largest_timestamp_gap_frame=""
    local timestamp_discontinuity="" timestamp_span_anomalous="" rc=0
    local -a cmd

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --duration|--name|--address|--output)
                [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value."
                case "$1" in
                    --duration) duration="$2" ;;
                    --name) target_name="$2" ;;
                    --address) target_address="$2" ;;
                    --output) output="$2" ;;
                esac
                shift 2
                ;;
            --advertising-only) advertising_only=true; shift ;;
            -h|--help) usage; return 0 ;;
            *) die "Unknown BLE option: $1" ;;
        esac
    done

    for dependency in nrfutil python3 capinfos tshark udevadm timeout stat awk sha256sum readlink date hostname mkdir; do
        require_command "$dependency"
    done

    [[ -e "$BLE_DEVICE" ]] || die "BLE capture radio not found: $BLE_DEVICE"
    port="$(readlink -e "$BLE_DEVICE")"
    [[ -n "$port" ]] || die "Unable to resolve $BLE_DEVICE"

    if [[ -n "$duration" ]]; then
        [[ "$duration" =~ ^[0-9]+$ ]] || die 'Duration must be a positive integer number of seconds.'
        [[ "$duration" =~ [1-9] ]] || die 'Duration must be greater than zero.'
    fi
    [[ -z "$target_name" || -z "$target_address" ]] || die '--name and --address cannot currently be used together.'

    date_dir="$(date +%Y-%m-%d)"
    timestamp="$(date +%H%M%S)"
    hostname="$(hostname -s)"
    capture_dir="${CAPTURE_ROOT}/ble/${date_dir}"

    if [[ -z "$output" ]]; then
        mkdir -p "$capture_dir"
        output="${capture_dir}/${hostname}_ble_${timestamp}.pcap"
    elif [[ "$output" != /* ]]; then
        output="${PWD}/${output}"
    fi
    metadata_file="${output%.*}.json"
    [[ ! -e "$output" && ! -L "$output" ]] || die "Output file already exists: $output"
    [[ ! -e "$metadata_file" && ! -L "$metadata_file" ]] || die "Metadata file already exists: $metadata_file"
    [[ -d "$(dirname "$output")" ]] || die "Output directory does not exist: $(dirname "$output")"

    cmd=(nrfutil ble-sniffer sniff --port "$port" --output-pcap-file "$output")
    [[ -z "$target_name" ]] || cmd+=(--follow-by-name "$target_name")
    [[ -z "$target_address" ]] || cmd+=(--follow "$target_address")
    [[ "$advertising_only" != true ]] || cmd+=(--only-advertising)

    printf "\nK'amal BLE Capture\n==================\n\n"
    printf 'Radio:       %s\nPort:        %s\nOutput:      %s\n' "$BLE_DEVICE" "$port" "$output"
    if [[ -n "$duration" ]]; then
        printf 'Duration:    %s seconds\n' "$duration"
    else
        printf 'Duration:    until Ctrl-C\n'
    fi
    [[ -z "$target_name" ]] || printf 'Target name: %s\n' "$target_name"
    [[ -z "$target_address" ]] || printf 'Target addr: %s\n' "$target_address"
    [[ "$advertising_only" != true ]] || printf 'Mode:        advertising only\n'
    printf '\n'

    start_time="$(date --iso-8601=seconds)"
    start_ns="$(date +%s%N)"
    if [[ -n "$duration" ]]; then
        # Handle timeout without disabling errexit globally.
        rc=0
        timeout --signal=INT --kill-after=5s "$duration" "${cmd[@]}" || rc=$?
        if [[ "$rc" -ne 0 && "$rc" -ne 124 ]]; then
            die "BLE capture failed with exit code $rc"
        fi
    else
        "${cmd[@]}"
    fi
    end_ns="$(date +%s%N)"
    end_time="$(date --iso-8601=seconds)"
    wall_duration="$(awk -v start="$start_ns" -v end="$end_ns" 'BEGIN {printf "%.3f", (end-start)/1000000000}')"

    [[ -s "$output" ]] || die 'Capture file was not created or is empty.'
    capinfo="$(capinfos "$output")" || die 'capinfos could not read the capture.'
    packet_count="$(awk -F: '/Number of packets:/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' <<< "$capinfo")"
    pcap_duration="$(awk -F: '/Capture duration:/ {gsub(/^[ \t]+/, "", $2); sub(/[[:space:]]+seconds$/, "", $2); print $2; exit}' <<< "$capinfo")"
    file_size="$(awk -F: '/File size:/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' <<< "$capinfo")"
    encapsulation="$(awk -F: '/File encapsulation:/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' <<< "$capinfo")"
    size_bytes="$(stat -c '%s' "$output")"
    sha256="$(sha256sum "$output" | awk '{print $1}')"

    [[ "$packet_count" =~ ^[0-9]+$ ]] || die 'Unable to determine packet count.'
    [[ "$pcap_duration" =~ ^[0-9]+([.][0-9]+)?$ ]] || die 'Unable to determine PCAP timestamp span.'
    [[ "$size_bytes" =~ ^[0-9]+$ ]] || die 'Unable to determine file size.'
    [[ "$sha256" =~ ^[[:xdigit:]]{64}$ ]] || die 'Unable to determine SHA-256.'
    [[ -n "$encapsulation" ]] || die 'Unable to determine capture encapsulation.'

    radio_serial="$(udevadm info --query=property --name="$port" 2>/dev/null | sed -n 's/^ID_SERIAL_SHORT=//p' || true)"

    # Collect all timestamp integrity metrics in a single tshark pass.
    # AWK uses numeric coercion on timestamps, but preserves the frame number.
    # The tshark exit status is checked separately: a failed analysis is not
    # misreported as a healthy capture.
    local timestamps_file=""
    timestamps_file="$(mktemp)" || die 'Unable to create temporary timestamp file.'
    if ! tshark -r "$output" -T fields -e frame.number -e frame.time_epoch > "$timestamps_file"; then
        rm -f "$timestamps_file"
        die 'tshark timestamp analysis failed.'
    fi
    timestamp_analysis="$(awk '
        NF >= 2 {
            frame=$1; current=$2+0
            if (seen) {
                delta=current-previous
                if (delta < 0) monotonic=0
                if (!have_gap || delta > max_gap) {
                    max_gap=delta; max_frame=frame; have_gap=1
                }
            } else { monotonic=1 }
            previous=current; seen=1
        }
        END {
            if (!seen) exit 2
            if (!have_gap) {max_gap=0; max_frame=0}
            printf "%s %.9f %s\n", monotonic ? "true" : "false", max_gap, max_frame
        }
    ' "$timestamps_file")" || { rm -f "$timestamps_file"; die 'No packet timestamps available for analysis.'; }
    rm -f "$timestamps_file"
    read -r timestamps_monotonic largest_timestamp_gap largest_timestamp_gap_frame <<< "$timestamp_analysis"
    [[ "$timestamps_monotonic" == true || "$timestamps_monotonic" == false ]] || die 'Invalid timestamp analysis result.'
    [[ "$largest_timestamp_gap" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || die 'Invalid timestamp gap.'
    [[ "$largest_timestamp_gap_frame" =~ ^[0-9]+$ ]] || die 'Invalid timestamp gap frame.'

    timestamp_discontinuity="$(awk -v gap="$largest_timestamp_gap" -v wall="$wall_duration" 'BEGIN {print (gap > wall) ? "true" : "false"}')"
    timestamp_span_anomalous="$(awk -v span="$pcap_duration" -v wall="$wall_duration" 'BEGIN {print (span > wall + 1.0) ? "true" : "false"}')"

    # Pass untrusted strings as arguments; Python performs JSON escaping.
    # Exclusive creation prevents silently overwriting existing sidecars.
    python3 - \
        "$metadata_file" "$output" "$hostname" "$start_time" "$end_time" \
        "$duration" "$wall_duration" "$BLE_DEVICE" "$port" "$radio_serial" \
        "$packet_count" "$size_bytes" "$encapsulation" "$pcap_duration" \
        "$timestamps_monotonic" "$largest_timestamp_gap" "$largest_timestamp_gap_frame" \
        "$timestamp_discontinuity" "$timestamp_span_anomalous" "$sha256" \
        "$target_name" "$target_address" "$advertising_only" <<'PY'
import json
import os
import sys

(
    metadata_file, capture_file, hostname, start_time, end_time,
    requested_duration, wall_duration, radio_device, resolved_device,
    radio_serial, packet_count, size_bytes, encapsulation, timestamp_span,
    timestamps_monotonic, largest_timestamp_gap, largest_timestamp_gap_frame,
    timestamp_discontinuity, timestamp_span_anomalous, sha256,
    target_name, target_address, advertising_only,
) = sys.argv[1:]

metadata = {
    "schema_version": "1.0",
    "capture": {
        "type": "ble",
        "hostname": hostname,
        "start_time": start_time,
        "end_time": end_time,
        "requested_duration_seconds": int(requested_duration) if requested_duration else None,
        "wall_duration_seconds": float(wall_duration),
        "packet_count": int(packet_count),
    },
    "radio": {
        "role": "ble-sniffer",
        "device": radio_device,
        "resolved_device": resolved_device,
        "serial": radio_serial or None,
        "hardware": "Nordic nRF52840 Dongle",
        "board": "PCA10059",
    },
    "pcap": {
        "file": os.path.basename(capture_file),
        "size_bytes": int(size_bytes),
        "encapsulation": encapsulation,
        "timestamp_span_seconds": float(timestamp_span),
        "timestamps_monotonic": timestamps_monotonic == "true",
        "largest_timestamp_gap_seconds": float(largest_timestamp_gap),
        "largest_timestamp_gap_frame": int(largest_timestamp_gap_frame),
        "timestamp_discontinuity_detected": timestamp_discontinuity == "true",
        "timestamp_span_anomalous": timestamp_span_anomalous == "true",
        "sha256": sha256,
    },
    "filters": {
        "name": target_name or None,
        "address": target_address or None,
        "advertising_only": advertising_only == "true",
    },
}

with open(metadata_file, "x", encoding="utf-8") as handle:
    json.dump(metadata, handle, indent=2)
    handle.write("\n")
PY

    printf '\nCapture complete.\n\n'
    printf 'Wall duration:             %s seconds\n' "$wall_duration"
    printf 'Packets:                   %s\n' "$packet_count"
    printf 'File size:                 %s\n' "${file_size:-${size_bytes} bytes}"
    printf 'PCAP timestamp span:       %s seconds\n' "$pcap_duration"
    printf 'Timestamps monotonic:      %s\n' "$timestamps_monotonic"
    printf 'Largest timestamp gap:     %s seconds (frame %s)\n' "$largest_timestamp_gap" "$largest_timestamp_gap_frame"
    printf 'Timestamp discontinuity:   %s\n' "$timestamp_discontinuity"
    printf 'Timestamp span anomalous:  %s\n' "$timestamp_span_anomalous"
    printf 'SHA256:                    %s\n' "$sha256"
    printf 'Metadata:                  %s\n' "$metadata_file"
    printf '\nSaved:\n%s\n' "$output"
}


capture_ble_adv3() {
    local duration="" target_address="" output_dir="" acquire_timeout="35"
    local date_dir="" timestamp="" hostname="" start_time="" end_time=""
    local steady_start_ns="" steady_end_ns="" steady_start_epoch="" steady_end_epoch="" steady_wall_duration=""
    local overall_status="ok" manifest="" channel="" timer_pid=""
    local -a channels=(37 38 39)
    local -A device port serial pid ready meta pcap stdout_file stderr_file stop_rc
    local -A packet_count size_bytes sha256 ch37_count ch38_count ch39_count other_count
    local -A valid_ch37_count valid_ch38_count valid_ch39_count valid_other_count
    local -A steady_valid_ch37_count steady_valid_ch38_count steady_valid_ch39_count steady_valid_other_count
    local -A mutation_count follow_request_count off_channel_count crc_valid_off_channel_count
    local -A validated_on_channel_count validated_off_channel_count untrusted_off_channel_count

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --duration|--address|--output-dir|--acquire-timeout)
                [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value."
                case "$1" in
                    --duration) duration="$2" ;;
                    --address) target_address="$2" ;;
                    --output-dir) output_dir="$2" ;;
                    --acquire-timeout) acquire_timeout="$2" ;;
                esac
                shift 2
                ;;
            -h|--help) usage; return 0 ;;
            *) die "Unknown BLE three-channel option: $1" ;;
        esac
    done

    [[ -n "$duration" ]] || die 'ble-adv3 requires --duration.'
    [[ "$duration" =~ ^[0-9]+$ && "$duration" =~ [1-9] ]] ||
        die 'Duration must be a positive integer number of seconds.'
    [[ -n "$target_address" ]] || die 'ble-adv3 requires --address.'
    [[ "$target_address" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] ||
        die 'Address must be a six-octet Bluetooth address.'
    [[ "$acquire_timeout" =~ ^[0-9]+$ && "$acquire_timeout" =~ [1-9] ]] ||
        die 'Acquire timeout must be a positive integer number of seconds.'

    for dependency in nrfutil python3 capinfos tshark udevadm stat awk sha256sum readlink date hostname mkdir setsid grep sleep kill; do
        require_command "$dependency"
    done
    [[ -r "$FIXED_ADV_PRELOAD" ]] ||
        die "Fixed advertising-channel adapter not found: $FIXED_ADV_PRELOAD (run setup/setup-ble-sniffer.sh)."

    device[37]="$BLE_ADV37_DEVICE"
    device[38]="$BLE_ADV38_DEVICE"
    device[39]="$BLE_ADV39_DEVICE"

    for channel in "${channels[@]}"; do
        [[ -e "${device[$channel]}" ]] ||
            die "BLE CH${channel} capture radio not found: ${device[$channel]}"
        port[$channel]="$(readlink -e "${device[$channel]}")"
        [[ -n "${port[$channel]}" ]] ||
            die "Unable to resolve ${device[$channel]}"
        serial[$channel]="$(udevadm info --query=property --name="${port[$channel]}" 2>/dev/null | sed -n 's/^ID_SERIAL_SHORT=//p' || true)"
    done

    [[ "${port[37]}" != "${port[38]}" && "${port[37]}" != "${port[39]}" && "${port[38]}" != "${port[39]}" ]] ||
        die 'ble-adv3 requires three distinct BLE sniffer devices.'

    date_dir="$(date +%Y-%m-%d)"
    timestamp="$(date +%H%M%S)"
    hostname="$(hostname -s)"
    if [[ -z "$output_dir" ]]; then
        output_dir="${CAPTURE_ROOT}/ble/${date_dir}/${hostname}_ble_adv3_${timestamp}"
    elif [[ "$output_dir" != /* ]]; then
        output_dir="${PWD}/${output_dir}"
    fi
    [[ ! -e "$output_dir" && ! -L "$output_dir" ]] ||
        die "Output path already exists: $output_dir"
    mkdir -p "$output_dir"
    manifest="$output_dir/manifest.json"

    for channel in "${channels[@]}"; do
        ready[$channel]="$output_dir/ch${channel}.follow-request"
        meta[$channel]="$output_dir/ch${channel}.shim.log"
        pcap[$channel]="$output_dir/ch${channel}.pcap"
        stdout_file[$channel]="$output_dir/ch${channel}.stdout.log"
        stderr_file[$channel]="$output_dir/ch${channel}.stderr.log"
    done

    printf "\nK'amal BLE Three-Channel Advertising Plane\n==========================================\n\n"
    printf 'Target addr:       %s\n' "$target_address"
    printf 'Steady duration:   %s seconds\n' "$duration"
    printf 'Acquire timeout:   %s seconds per receiver\n' "$acquire_timeout"
    printf 'Output directory:  %s\n' "$output_dir"
    for channel in "${channels[@]}"; do
        printf 'CH%s:               %s -> %s (serial %s)\n' \
            "$channel" "${device[$channel]}" "${port[$channel]}" "${serial[$channel]:-unknown}"
    done
    printf '\n'

    start_receiver() {
        local ch="$1"
        setsid env \
            LD_PRELOAD="$FIXED_ADV_PRELOAD" \
            KAMAL_PRELOAD_TARGET="${port[$ch]}" \
            KAMAL_PRELOAD_METALOG="${meta[$ch]}" \
            KAMAL_PRELOAD_READY_FILE="${ready[$ch]}" \
            KAMAL_FIXED_ADV_CHANNEL="$ch" \
            nrfutil ble-sniffer sniff \
                --port "${port[$ch]}" \
                --baudrate 1000000 \
                --follow "$target_address" \
                --only-advertising \
                --output-pcap-file "${pcap[$ch]}" \
                >"${stdout_file[$ch]}" \
                2>"${stderr_file[$ch]}" &
        pid[$ch]=$!
    }

    wait_for_follow_request() {
        local ch="$1" deadline=$((SECONDS + acquire_timeout))
        while (( SECONDS < deadline )); do
            [[ -s "${ready[$ch]}" ]] && return 0
            kill -0 "${pid[$ch]}" 2>/dev/null || return 1
            sleep 0.1
        done
        return 1
    }

    stop_receiver() {
        local ch="$1"
        local receiver_pid="${pid[$ch]:-}" rc=0 deadline=""
        [[ -n "$receiver_pid" ]] || { stop_rc[$ch]="not-started"; return 0; }
        if kill -0 "$receiver_pid" 2>/dev/null; then
            kill -INT -- "-$receiver_pid" 2>/dev/null || kill -INT "$receiver_pid" 2>/dev/null || true
            deadline=$((SECONDS + 4))
            while kill -0 "$receiver_pid" 2>/dev/null && (( SECONDS < deadline )); do sleep 0.1; done
            if kill -0 "$receiver_pid" 2>/dev/null; then
                kill -TERM -- "-$receiver_pid" 2>/dev/null || kill -TERM "$receiver_pid" 2>/dev/null || true
                deadline=$((SECONDS + 2))
                while kill -0 "$receiver_pid" 2>/dev/null && (( SECONDS < deadline )); do sleep 0.1; done
            fi
            if kill -0 "$receiver_pid" 2>/dev/null; then
                kill -KILL -- "-$receiver_pid" 2>/dev/null || kill -KILL "$receiver_pid" 2>/dev/null || true
            fi
        fi
        wait "$receiver_pid" 2>/dev/null || rc=$?
        stop_rc[$ch]="$rc"
    }

    cleanup_adv3() {
        local ch=""
        set +e
        [[ -n "$timer_pid" ]] && kill "$timer_pid" 2>/dev/null || true
        for ch in "${channels[@]}"; do
            if [[ -n "${pid[$ch]:-}" ]] && kill -0 "${pid[$ch]}" 2>/dev/null; then
                kill -KILL -- "-${pid[$ch]}" 2>/dev/null || kill -KILL "${pid[$ch]}" 2>/dev/null || true
                wait "${pid[$ch]}" 2>/dev/null || true
            fi
        done
    }

    abort_adv3() {
        local ch=""
        set +e
        [[ -n "$timer_pid" ]] && kill "$timer_pid" 2>/dev/null || true
        for ch in "${channels[@]}"; do
            stop_receiver "$ch"
        done
        trap - EXIT INT TERM HUP
        exit 130
    }

    trap cleanup_adv3 EXIT
    trap abort_adv3 INT TERM HUP

    start_time="$(date --iso-8601=seconds)"
    for channel in "${channels[@]}"; do
        start_receiver "$channel"
        if ! wait_for_follow_request "$channel"; then
            overall_status="follow-request-failed"
            warn "CH${channel} did not issue its follow request within ${acquire_timeout} seconds."
            break
        fi
        log "CH${channel} fixed-channel command applied and follow request sent."
        sleep 0.25
    done

    if [[ "$overall_status" == "ok" ]]; then
        steady_start_epoch="$(date +%s.%N)"
        steady_start_ns="${steady_start_epoch/./}"
        sleep "$duration" & timer_pid=$!
        wait "$timer_pid"
        timer_pid=""
        steady_end_epoch="$(date +%s.%N)"
        steady_end_ns="${steady_end_epoch/./}"
        steady_wall_duration="$(awk -v start="$steady_start_ns" -v end="$steady_end_ns" 'BEGIN {printf "%.3f", (end-start)/1000000000}')"
    fi

    for channel in "${channels[@]}"; do
        stop_receiver "$channel"
    done
    end_time="$(date --iso-8601=seconds)"
    trap - EXIT INT TERM HUP

    for channel in "${channels[@]}"; do
        packet_count[$channel]=0
        size_bytes[$channel]=0
        sha256[$channel]=""
        ch37_count[$channel]=0
        ch38_count[$channel]=0
        ch39_count[$channel]=0
        other_count[$channel]=0
        valid_ch37_count[$channel]=0
        valid_ch38_count[$channel]=0
        valid_ch39_count[$channel]=0
        valid_other_count[$channel]=0
        steady_valid_ch37_count[$channel]=0
        steady_valid_ch38_count[$channel]=0
        steady_valid_ch39_count[$channel]=0
        steady_valid_other_count[$channel]=0
        mutation_count[$channel]=0
        follow_request_count[$channel]=0
        off_channel_count[$channel]=0
        crc_valid_off_channel_count[$channel]=0
        validated_on_channel_count[$channel]=0
        validated_off_channel_count[$channel]=0
        untrusted_off_channel_count[$channel]=0

        if [[ ! -s "${pcap[$channel]}" ]]; then
            [[ "$overall_status" != "ok" ]] || overall_status="capture-missing"
            continue
        fi

        local capinfo=""
        capinfo="$(capinfos "${pcap[$channel]}")" || {
            [[ "$overall_status" != "ok" ]] || overall_status="capture-invalid"
            continue
        }
        packet_count[$channel]="$(awk -F: '/Number of packets:/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' <<< "$capinfo")"
        size_bytes[$channel]="$(stat -c '%s' "${pcap[$channel]}")"
        sha256[$channel]="$(sha256sum "${pcap[$channel]}" | awk '{print $1}')"

        read -r \
            ch37_count[$channel] ch38_count[$channel] ch39_count[$channel] other_count[$channel] \
            valid_ch37_count[$channel] valid_ch38_count[$channel] valid_ch39_count[$channel] valid_other_count[$channel] \
            steady_valid_ch37_count[$channel] steady_valid_ch38_count[$channel] steady_valid_ch39_count[$channel] steady_valid_other_count[$channel] < <(
            python3 - "${pcap[$channel]}" "$steady_start_epoch" "$steady_end_epoch" <<'PY'
from decimal import Decimal, InvalidOperation
import subprocess
import sys

pcap, steady_start_raw, steady_end_raw = sys.argv[1:]
steady_start = Decimal(steady_start_raw)
steady_end = Decimal(steady_end_raw)

cmd = [
    "tshark",
    "-r", pcap,
    "-T", "fields",
    "-E", "separator=/t",
    "-E", "occurrence=f",
    "-e", "frame.time_epoch",
    "-e", "nordic_ble.channel",
    "-e", "nordic_ble.crcok",
]
proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
if proc.returncode != 0:
    sys.stderr.write(proc.stderr)
    raise SystemExit(proc.returncode)

counts = {37: 0, 38: 0, 39: 0, "other": 0}
valid = {37: 0, 38: 0, 39: 0, "other": 0}
steady_valid = {37: 0, 38: 0, 39: 0, "other": 0}

for raw in proc.stdout.splitlines():
    parts = raw.split("\t")
    if len(parts) != 3:
        continue
    epoch_raw, channel_raw, crcok = parts
    if not channel_raw:
        continue

    try:
        channel = int(channel_raw)
    except ValueError:
        channel = "other"

    key = channel if channel in (37, 38, 39) else "other"
    counts[key] += 1

    if crcok != "True":
        continue

    valid[key] += 1

    try:
        epoch = Decimal(epoch_raw)
    except (InvalidOperation, ValueError):
        continue

    if steady_start <= epoch <= steady_end:
        steady_valid[key] += 1

print(
    counts[37], counts[38], counts[39], counts["other"],
    valid[37], valid[38], valid[39], valid["other"],
    steady_valid[37], steady_valid[38], steady_valid[39], steady_valid["other"],
)
PY
        )

        mutation_count[$channel]="$(grep -c '^MUTATED ' "${meta[$channel]}" 2>/dev/null || true)"
        follow_request_count[$channel]="$(grep -c '^FOLLOW_REQUEST_SENT$' "${meta[$channel]}" 2>/dev/null || true)"

        if ! [[ "${packet_count[$channel]}" =~ ^[0-9]+$ ]] || (( packet_count[$channel] <= 0 )); then
            [[ "$overall_status" != "ok" ]] || overall_status="capture-empty"
        fi

        case "$channel" in
            37)
                validated_on_channel_count[$channel]="${steady_valid_ch37_count[$channel]}"
                off_channel_count[$channel]=$((ch38_count[$channel] + ch39_count[$channel] + other_count[$channel]))
                crc_valid_off_channel_count[$channel]=$((valid_ch38_count[$channel] + valid_ch39_count[$channel] + valid_other_count[$channel]))
                validated_off_channel_count[$channel]=$((steady_valid_ch38_count[$channel] + steady_valid_ch39_count[$channel] + steady_valid_other_count[$channel]))
                ;;
            38)
                validated_on_channel_count[$channel]="${steady_valid_ch38_count[$channel]}"
                off_channel_count[$channel]=$((ch37_count[$channel] + ch39_count[$channel] + other_count[$channel]))
                crc_valid_off_channel_count[$channel]=$((valid_ch37_count[$channel] + valid_ch39_count[$channel] + valid_other_count[$channel]))
                validated_off_channel_count[$channel]=$((steady_valid_ch37_count[$channel] + steady_valid_ch39_count[$channel] + steady_valid_other_count[$channel]))
                ;;
            39)
                validated_on_channel_count[$channel]="${steady_valid_ch39_count[$channel]}"
                off_channel_count[$channel]=$((ch37_count[$channel] + ch38_count[$channel] + other_count[$channel]))
                crc_valid_off_channel_count[$channel]=$((valid_ch37_count[$channel] + valid_ch38_count[$channel] + valid_other_count[$channel]))
                validated_off_channel_count[$channel]=$((steady_valid_ch37_count[$channel] + steady_valid_ch38_count[$channel] + steady_valid_other_count[$channel]))
                ;;
        esac
        untrusted_off_channel_count[$channel]=$((off_channel_count[$channel] - crc_valid_off_channel_count[$channel]))

        if (( mutation_count[$channel] != 1 || follow_request_count[$channel] != 1 || validated_on_channel_count[$channel] <= 0 || validated_off_channel_count[$channel] != 0 )); then
            [[ "$overall_status" != "ok" ]] || overall_status="channel-validation-failed"
        fi
    done

    python3 - \
        "$manifest" "$hostname" "$start_time" "$end_time" "$duration" "${steady_wall_duration:-0}" "${steady_start_epoch:-}" "${steady_end_epoch:-}" \
        "$target_address" "$overall_status" "$FIXED_ADV_PRELOAD" \
        "${device[37]}" "${port[37]}" "${serial[37]}" "${pcap[37]}" "${packet_count[37]}" "${size_bytes[37]}" "${sha256[37]}" "${ch37_count[37]}" "${ch38_count[37]}" "${ch39_count[37]}" "${other_count[37]}" "${valid_ch37_count[37]}" "${valid_ch38_count[37]}" "${valid_ch39_count[37]}" "${valid_other_count[37]}" "${steady_valid_ch37_count[37]}" "${steady_valid_ch38_count[37]}" "${steady_valid_ch39_count[37]}" "${steady_valid_other_count[37]}" "${mutation_count[37]}" "${follow_request_count[37]}" "${stop_rc[37]}" \
        "${device[38]}" "${port[38]}" "${serial[38]}" "${pcap[38]}" "${packet_count[38]}" "${size_bytes[38]}" "${sha256[38]}" "${ch37_count[38]}" "${ch38_count[38]}" "${ch39_count[38]}" "${other_count[38]}" "${valid_ch37_count[38]}" "${valid_ch38_count[38]}" "${valid_ch39_count[38]}" "${valid_other_count[38]}" "${steady_valid_ch37_count[38]}" "${steady_valid_ch38_count[38]}" "${steady_valid_ch39_count[38]}" "${steady_valid_other_count[38]}" "${mutation_count[38]}" "${follow_request_count[38]}" "${stop_rc[38]}" \
        "${device[39]}" "${port[39]}" "${serial[39]}" "${pcap[39]}" "${packet_count[39]}" "${size_bytes[39]}" "${sha256[39]}" "${ch37_count[39]}" "${ch38_count[39]}" "${ch39_count[39]}" "${other_count[39]}" "${valid_ch37_count[39]}" "${valid_ch38_count[39]}" "${valid_ch39_count[39]}" "${valid_other_count[39]}" "${steady_valid_ch37_count[39]}" "${steady_valid_ch38_count[39]}" "${steady_valid_ch39_count[39]}" "${steady_valid_other_count[39]}" "${mutation_count[39]}" "${follow_request_count[39]}" "${stop_rc[39]}" <<'PY'
import json
import os
import sys

args = iter(sys.argv[1:])
manifest = next(args)
hostname = next(args)
start_time = next(args)
end_time = next(args)
duration = int(next(args))
steady_wall = float(next(args))
steady_start_epoch = next(args) or None
steady_end_epoch = next(args) or None
target_address = next(args)
status = next(args)
preload = next(args)

radios = []
for channel in (37, 38, 39):
    device = next(args)
    port = next(args)
    serial = next(args)
    pcap = next(args)
    packets = int(next(args))
    size = int(next(args))
    digest = next(args) or None
    counts = {
        "37": int(next(args)),
        "38": int(next(args)),
        "39": int(next(args)),
        "other": int(next(args)),
    }
    crc_valid_counts = {
        "37": int(next(args)),
        "38": int(next(args)),
        "39": int(next(args)),
        "other": int(next(args)),
    }
    validated_counts = {
        "37": int(next(args)),
        "38": int(next(args)),
        "39": int(next(args)),
        "other": int(next(args)),
    }
    mutations = int(next(args))
    follow_requests = int(next(args)
    )
    stop_rc = next(args)
    off_channel = sum(value for key, value in counts.items() if key != str(channel))
    crc_valid_off_channel = sum(
        value for key, value in crc_valid_counts.items() if key != str(channel)
    )
    validated_off_channel = sum(
        value for key, value in validated_counts.items() if key != str(channel)
    )
    untrusted_off_channel = off_channel - crc_valid_off_channel
    radios.append({
        "channel": channel,
        "device": device,
        "resolved_device": port,
        "serial": serial or None,
        "pcap": {
            "file": os.path.basename(pcap),
            "packet_count": packets,
            "size_bytes": size,
            "sha256": digest,
            "channel_counts": counts,
            "crc_valid_channel_counts": crc_valid_counts,
            "validated_channel_counts": validated_counts,
            "off_channel_packets": off_channel,
            "whole_capture_crc_valid_off_channel_packets": crc_valid_off_channel,
            "validated_off_channel_packets": validated_off_channel,
            "untrusted_off_channel_packets": untrusted_off_channel,
            "channel_validation_basis": "steady interval && nordic_ble.crcok == True",
        },
        "adapter": {
            "hop_sequence_mutations": mutations,
            "follow_requests_sent": follow_requests,
        },
        "stop_rc": stop_rc,
    })

metadata = {
    "schema_version": "1.0",
    "capture": {
        "type": "ble-fixed-advertising-plane",
        "hostname": hostname,
        "start_time": start_time,
        "end_time": end_time,
        "requested_steady_duration_seconds": duration,
        "steady_wall_duration_seconds": steady_wall,
        "steady_start_epoch": steady_start_epoch,
        "steady_end_epoch": steady_end_epoch,
        "status": status,
    },
    "target": {"address": target_address},
    "orchestration": {
        "staggered_follow_request_start": True,
        "follow_request_is_host_command_evidence": True,
        "follow_request_is_not_rf_acquisition_confirmation": True,
        "preload_adapter": preload,
    },
    "radios": radios,
}

with open(manifest, "x", encoding="utf-8") as handle:
    json.dump(metadata, handle, indent=2)
    handle.write("\n")
PY

    printf '\nThree-channel BLE advertising capture complete.\n\n'
    for channel in "${channels[@]}"; do
        printf 'CH%s packets: %-8s on-channel(valid,steady): %-5s off-channel(valid,steady): %-5s untrusted: %-5s SHA256: %s\n' \
            "$channel" "${packet_count[$channel]}" "${validated_on_channel_count[$channel]}" \
            "${validated_off_channel_count[$channel]}" "${untrusted_off_channel_count[$channel]}" "${sha256[$channel]:-unavailable}"
    done
    printf 'Manifest: %s\n' "$manifest"
    printf 'Status:   %s\n' "$overall_status"

    [[ "$overall_status" == "ok" ]] ||
        die "BLE three-channel advertising capture completed with status: $overall_status"
}

main() {
    [[ $# -gt 0 ]] || { usage; exit 1; }
    case "$1" in
        list) shift; [[ $# -eq 0 ]] || die 'list takes no arguments.'; radio_list ;;
        ble) shift; capture_ble "$@" ;;
        ble-adv3) shift; capture_ble_adv3 "$@" ;;
        version|--version) printf 'kamal-capture %s\n' "$VERSION" ;;
        help|-h|--help) usage ;;
        *) die "Unknown capture type: $1" ;;
    esac
}

main "$@"
